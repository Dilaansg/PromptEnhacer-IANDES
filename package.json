{
  "name": "iandes-chrome-extension",
  "version": "6.0.0",
  "description": "Chrome Extension for IAndes - Asistente de ingeniería de prompts para LLMs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "jest --passWithNoTests",
    "test:unit": "node test_layer1.js",
    "test:classify": "node test_classify.js",
    "test:dedup": "node test_dedup.js",
    "test:pipeline": "node test_pipeline.js",
    "test:all": "node test_layer1.js && node test_classify.js && node test_dedup.js",
    "build:transformers": "node scripts/build-transformers.js",
    "test:integration": "echo 'Running integration tests' && exit 0",
    "test:sandbox": "echo 'Running sandbox tests' && exit 0",
    "ci:verify": "npm run test:all && npm run test:integration && npm run test:sandbox",
    "generate:anchors": "npx tsx scripts/generate-anchors.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "chai": "^4.3.4",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mocha": "^10.0.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.0"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2"
  }
}
